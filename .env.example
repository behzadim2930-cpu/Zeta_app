# ============================================================
# Zeta Telegram Bot - Environment Variables Template
# متغیرهای محیطی ربات برنامه‌ریزی هفتگی موسسه زتا (Zeta)
# ============================================================

# توکن دریافتی از BotFather در تلگرام (الزامی)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# آدرس عمومی هاست شده ربات روی Render برای وب‌هوک (بدون اسلش پایانی)
# مثال: https://zeta-bot.onrender.com
WEBHOOK_URL=https://your-service-name.onrender.com

# پورت وب‌سرور (رندر به طور خودکار این مقدار را به 10000 تنظیم می‌کند)
PORT=10000

# لیست شناسه‌های عددی تلگرام مشاوران مجاز به استفاده (جدا شده با کاما)
# برای به دست آوردن آیدی، مشاور باید به ربات @userinfobot در تلگرام پیام بدهد
# اگر خالی باشد، در محیط تست دسترسی برای همه باز خواهد بود
ALLOWED_IDS=123456789,987654321

# حالت دیباگ لاگ‌ها (true یا false)
DEBUG=false
